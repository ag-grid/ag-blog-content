    "version": "3.0.0",
    "schema": {
        "expressions": [
            {
                "isMeasure": false,
                "id": "expression-1",
                "tableId": "purchase-orders",
                "format": "currencyFormat"
            },
            {
                "isMeasure": false,
                "id": "expression-2",
                "tableId": "purchase-orders",
                "format": "booleanFormat"
            },
            {
                "isMeasure": false,
                "id": "expression-3",
                "tableId": "purchase-orders",
                "format": "integerFormat"
            },
            {
                "isMeasure": true,
                "id": "expression-4",
                "tableId": "purchase-orders",
                "format": "percentageFormat"
            },
            {
                "isMeasure": true,
                "id": "expression-5",
                "tableId": "purchase-orders",
                "format": "percentageFormat"
            }
        ],
        "fields": {
            "expression-1": {
                "name": "Total spend amount",
                "expression": "MULTIPLY([purchase-orders.quantity], [purchase-orders.unitCost])",
                "format": "$#,##0.00,,\\M"
            },
            "expression-2": {
                "name": "On time",
                "expression": "LESSTHANOREQUAL([schema-state-expression-55], 0)",
                "format": "@"
            },
            "expression-3": {
                "name": "Days late",
                "expression": "DATEDIFF(\"day\", [purchase-orders.expectedDate], [purchase-orders.actualDate])",
                "format": "#,##0"
            },
            "expression-4": {
                "name": "% On-time delivery",
                "expression": "DIVIDE(COUNT([schema-state-expression-54]), COUNT([purchase-orders.poId]))",
                "format": "#,##0%"
            },
            "expression-5": {
                "name": "% units accepted",
                "expression": "DIVIDE(SUM([purchase-orders.acceptedQuantity]),SUM([purchase-orders.quantity]))",
                "format": "#,##0.00%"
            },
            "suppliers.name": {
                "name": "Supplier name",
                "format": "@"
            },
            "materials.name": {
                "name": "Material name",
                "format": "@"
            }
        }
    },
