# Copy to .env.local (gitignored) and fill in, or export these from your shell instead.

# Base URL of an OpenAI-compatible Responses API. Leave empty to switch ask_studio_analyst off.
AI_API_URL=https://api.openai.com/v1

# API key for AI_API_URL. Only used by `npm run dev`; production builds never include it.
AI_API_TOKEN=

# Base URL that getWeatherData() loads ghcn-cities/*.json from. Empty means this site's root,
# i.e. public/ghcn-cities/.
VITE_ASSETS_BASE_URL=
