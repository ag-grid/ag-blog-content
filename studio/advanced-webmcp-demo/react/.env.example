# Vite reads VITE_* vars from .env.local (gitignored) or from your shell environment.
#
# The AG AI proxy (the default endpoint) accepts requests from blog.ag-grid.com without a key. On
# localhost it needs a dev key: export AG_AI_API_DEV_TOKEN in your shell and the dev server passes
# it through (see vite.config.ts). Production builds never include it.
# Set to empty to switch the analyst off.
# VITE_AI_API_URL=https://ai-api.ag-grid.com/api/openai/v1

# Base URL that getWeatherData() loads ghcn-cities/*.json from. Empty means this site's root,
# i.e. public/ghcn-cities/.
VITE_ASSETS_BASE_URL=
